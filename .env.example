# Copy to .env and fill in. .env is git-ignored - never commit real credentials.

# Plivo console -> Overview page
PLIVO_AUTH_ID=your_auth_id
PLIVO_AUTH_TOKEN=your_auth_token

# Plivo number the call is made FROM (also used as caller ID when forwarding)
PLIVO_NUMBER=+918035454161
# Live associate for menu option 2 (local formats like 02264236412 also work)
ASSOCIATE_NUMBER=+912264236412
# Your phone - the call is made TO this number
MY_PHONE_NUMBER=+91XXXXXXXXXX

# Public URL Plivo uses to reach this server (your ngrok https URL, no trailing slash)
BASE_URL=https://your-subdomain.ngrok-free.app

# Publicly accessible MP3 played for menu option 1
AUDIO_URL=https://s3.amazonaws.com/plivocloud/Trumpet.mp3

# Reject webhook requests without a valid Plivo signature
VALIDATE_SIGNATURE=true

# Local port (5000 is taken by AirPlay on macOS)
PORT=8000
